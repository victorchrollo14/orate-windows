<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "app". Signs Orate's own binaries before vpk packs them.
     The workflow uploads a zip containing only Orate.exe and Orate.dll. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Orate" product-version="${version}">
      <include path="Orate.exe" />
      <include path="Orate.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
